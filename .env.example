# Copia este archivo como .env y completa los valores (pega cada key justo después del =,
# sin espacios ni comillas). .env está en .gitignore: nunca se sube al repositorio.
# Keys en https://developer.riotgames.com/

# Key para League of Legends (Personal API Key o la development key, que caduca cada 24 h)
RIOT_API_KEY=

# Key para Teamfight Tactics. Si la dejas vacía se usa la de LoL.
RIOT_API_KEY_TFT=
