// Configuración del Worker para Cloudflare (se publica con: npx wrangler deploy).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lolsapo-disparador",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  // Sin URL pública (*.workers.dev) ni rutas: nadie puede ejecutarlo desde internet.
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    // Cada 5 minutos (hora UTC). Para cambiar el intervalo, edita esta línea y vuelve a
    // publicar. Menos de 5 no conviene: cada publicación tarda ~3 min y la key de Riot
    // tiene un límite de consultas.
    "crons": ["*/5 * * * *"]
  },
  // Variables públicas (no son secretas). El token va aparte: npx wrangler secret put GH_TOKEN
  "vars": {
    "REPO": "JCarvajalLab/LOLSapo",
    "WORKFLOW": "publicar.yml",
    "RAMA": "main"
  },
  // Sin telemetría de wrangler.
  "send_metrics": false,
  // Logs de cada ejecución (para ver errores en el panel), sin trazas de las peticiones
  // salientes: se fija explícitamente para no depender de los valores por defecto.
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": true },
    "traces": { "enabled": false }
  }
}
